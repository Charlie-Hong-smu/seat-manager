{
  "name": "seat-manager-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:zhang": "vite build",
    "build:commercial": "VITE_EDITION=commercial VITE_BASE=/ vite build",
    "check:size": "node scripts/check-build-size.mjs",
    "check:design": "node scripts/check-design-system.mjs",
    "check:production": "node scripts/check-production-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:zhang",
    "test:e2e:zhang": "E2E_EDITION=zhang playwright test",
    "test:e2e:commercial": "E2E_EDITION=commercial playwright test",
    "test:e2e:all": "pnpm test:e2e:zhang && pnpm test:e2e:commercial",
    "check": "pnpm check:design && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "5.6.3",
    "typescript-eslint": "8.63.0",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-window": "7.4.1"
  }
}
